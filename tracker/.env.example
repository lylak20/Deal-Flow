# Copy to tracker/.env for local runs. Never commit .env or the key file.

# Key for the model chosen in config.yaml (llm.provider). Only that one is required.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Path to the service account key file (locally), or the whole JSON on one line (GitHub secret).
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
